# Copy to .env.local for development. Never commit real values.

# Postgres.
# Production (Vercel): the pooled Neon address of the "website" user (WEBSITE_DB_URL in the root .env):
#   DATABASE_URL=postgresql://website:<password>@<endpoint>-pooler.<region>.aws.neon.tech/catalogue?sslmode=verify-full
# Development: leave DATABASE_URL empty and use the standard PG* variables, for example:
DATABASE_URL=
PGHOST=/path/to/the_catalogue/.devdb/sock
PGPORT=54333
PGDATABASE=catalogue

# Telegram bot username (without @). Empty = the "Notify me" button says alerts are not set up yet.
TELEGRAM_BOT_USERNAME=
# The same value that was given to setWebhook as secret_token. Requests without it get 401.
TELEGRAM_WEBHOOK_SECRET=

# Secret text for the hash of visitor IP addresses ("Notify me" limit: 10 per hour).
RATE_LIMIT_SALT=
