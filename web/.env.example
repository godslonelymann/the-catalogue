# Copy to .env.local (development) or .env.production.local (server). Never commit real values.

# Postgres, using the standard PG* variables.
# Server (peer login over the local socket):
PGHOST=/var/run/postgresql
PGDATABASE=catalogue
# PGUSER defaults to the Linux user that runs the website.

# Telegram bot username (without @). Empty = the "Notify me" button says alerts are not set up yet.
TELEGRAM_BOT_USERNAME=
