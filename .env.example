# Copy this file to .env and fill in the values. Never commit .env.

# Postgres connection (libpq format). On the server, "dbname=catalogue" uses peer login.
CATALOGUE_DB=dbname=catalogue

# Where raw JSON goes: an S3 bucket (s3://name) or a local folder path (for testing).
CATALOGUE_STORAGE=s3://the-catalogue-raw-anurag
AWS_REGION=ap-south-1

# Telegram bot from @BotFather. Leave the token empty to log messages instead of sending them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Seconds to wait between requests to a store (be polite).
CATALOGUE_REQUEST_DELAY=1
