# Copy this file to .env and fill in the values. Never commit .env.

# Postgres connection: a libpq string or a URL.
#   Local test database:  host=/path/to/.devdb/sock port=54333 dbname=catalogue
#   Neon (GitHub secret): postgresql://pipeline:<password>@<endpoint>.<region>.aws.neon.tech/catalogue?sslmode=verify-full&sslrootcert=system&channel_binding=require
CATALOGUE_DB=dbname=catalogue

# Where raw JSON goes: an S3 bucket (s3://name) or a local folder path (for testing).
CATALOGUE_STORAGE=s3://the-catalogue-raw-anurag
AWS_REGION=ap-south-1

# Telegram bot from @BotFather. Leave the token empty to log messages instead of sending them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Seconds to wait between requests to a store (be polite).
CATALOGUE_REQUEST_DELAY=1

# Neon owner address (direct, pooling OFF). Only for migrations from your Mac:
#   CATALOGUE_DB="$NEON_OWNER_URL" python -m pipeline migrate
# Never put it in GitHub or Vercel.
NEON_OWNER_URL=
